# Primary provider is yfinance (no key needed).
# Twelve Data is the secondary/fallback provider.
TWELVE_DATA_API_KEY=

# Your own Neon Postgres instance (not shared with teammates).
# Use the pooled connection string (host with "-pooler" suffix).
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/technical_analyst?sslmode=require

# In-memory cache TTL for a single process run (seconds).
CACHE_TTL_SECONDS=300

LOG_LEVEL=INFO

# Comma-separated list of allowed Host headers for DNS rebinding protection.
# Leave empty to disable protection (dev only).
MCP_ALLOWED_HOSTS=
