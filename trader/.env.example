# Exness / MetaTrader 5 account credentials (used to log into the sidecar).
EXNESS_LOGIN=
EXNESS_PASSWORD=
EXNESS_SERVER=

# Postgres database for storing trade proposals.
DATABASE_URL=

# MT5 sidecar connection (defaults shown).
# The trader MCP server connects (via the mt5linux bridge) to a separate
# Wine + MetaTrader 5 sidecar over RPyC.
MT5_HOST=mt5-sidecar
MT5_PORT=18812
MT5_CONNECT_TIMEOUT=300
