{
  "$schema": "https://render.com/schema/render.yaml",
  "name": "fifty-shades-of-agent",
  "services": [
    {
      "type": "web",
      "name": "news-scraper",
      "runtime": "docker",
      "repo": "https://github.com/AshayaSah/fifty-shades-of-agent",
      "dockerfilePath": "news-scraper/Dockerfile",
      "buildContext": "news-scraper",
      "healthCheckPath": "/mcp/",
      "autoDeploy": true,
      "envVars": [
        { "key": "DATABASE_URL", "sync": false },
        { "key": "NEWSAPI_KEY", "sync": false }
      ]
    },
    {
      "type": "web",
      "name": "technical-analyst",
      "runtime": "docker",
      "repo": "https://github.com/AshayaSah/fifty-shades-of-agent",
      "dockerfilePath": "technical-analyst/Dockerfile",
      "buildContext": "technical-analyst",
      "healthCheckPath": "/mcp/",
      "autoDeploy": true,
      "envVars": [
        { "key": "NEON_DATABASE_URL", "sync": false },
        { "key": "TWELVE_DATA_API_KEY", "sync": false },
        { "key": "CACHE_TTL_SECONDS", "value": "300" },
        { "key": "LOG_LEVEL", "value": "INFO" },
        { "key": "MCP_ALLOWED_HOSTS", "value": "" }
      ]
    },
    {
      "type": "web",
      "name": "trader",
      "runtime": "docker",
      "repo": "https://github.com/AshayaSah/fifty-shades-of-agent",
      "dockerfilePath": "trader/Dockerfile",
      "buildContext": "trader",
      "healthCheckPath": "/mcp/",
      "autoDeploy": true,
      "envVars": [
        { "key": "DATABASE_URL", "sync": false },
        { "key": "EXNESS_LOGIN", "sync": false },
        { "key": "EXNESS_PASSWORD", "sync": false },
        { "key": "EXNESS_SERVER", "sync": false },
        { "key": "MT5_HOST", "value": "mt5-sidecar" },
        { "key": "MT5_PORT", "value": "18812" },
        { "key": "MT5_CONNECT_TIMEOUT", "value": "300" }
      ]
    }
  ]
}
